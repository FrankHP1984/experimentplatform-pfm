spring.application.name=experimentplatform

# Database (Supabase connection pooler)
spring.datasource.url=jdbc:postgresql://aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
spring.datasource.username=postgres.TU_PROJECT_REF
spring.datasource.password=TU_DB_PASSWORD
spring.datasource.hikari.connection-test-query=SELECT 1
spring.datasource.hikari.keepalive-time=60000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# CORS -- URLs del frontend (desarrollo local)
cors.allowed-origins=http://localhost:3000,http://localhost:5173

# Supabase
supabase.url=https://TU_PROJECT_REF.supabase.co
supabase.anon-key=TU_ANON_KEY
supabase.jwt-secret=TU_JWT_SECRET
